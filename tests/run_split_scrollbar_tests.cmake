if(NOT DEFINED TEST_BINARY OR NOT DEFINED TEST_DIR OR NOT DEFINED TEST_DOC)
    message(FATAL_ERROR "TEST_BINARY, TEST_DIR and TEST_DOC are required")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}")
file(COPY "${TEST_BINARY}" DESTINATION "${TEST_DIR}")
file(WRITE "${TEST_DIR}/settings.ini" "[Settings]\nhasAskedFileAssociation=1\ncheckUpdates=0\n")
# The test edits a copy: a failing run must not save into the fixture
file(COPY "${TEST_DOC}" DESTINATION "${TEST_DIR}")
get_filename_component(TEST_NAME "${TEST_BINARY}" NAME)
get_filename_component(TEST_DOC_NAME "${TEST_DOC}" NAME)
# A second document with front matter, when given (#291)
set(TEST_DOC2_ARG "")
if(DEFINED TEST_DOC2)
    file(COPY "${TEST_DOC2}" DESTINATION "${TEST_DIR}")
    get_filename_component(TEST_DOC2_NAME "${TEST_DOC2}" NAME)
    set(TEST_DOC2_ARG "${TEST_DIR}/${TEST_DOC2_NAME}")
endif()
# Long unwrapped lines, for the bar along the editor's foot (#314)
set(TEST_DOC3_ARG "")
if(DEFINED TEST_DOC3)
    file(COPY "${TEST_DOC3}" DESTINATION "${TEST_DIR}")
    get_filename_component(TEST_DOC3_NAME "${TEST_DOC3}" NAME)
    set(TEST_DOC3_ARG "${TEST_DIR}/${TEST_DOC3_NAME}")
endif()
execute_process(COMMAND "${TEST_DIR}/${TEST_NAME}" --split-scrollbar-tests "${TEST_DIR}/${TEST_DOC_NAME}" ${TEST_DOC2_ARG} ${TEST_DOC3_ARG}
    WORKING_DIRECTORY "${TEST_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Split scrollbar tests failed: ${result}")
endif()
